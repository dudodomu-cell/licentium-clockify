# Supabase project — create at https://supabase.com/dashboard, then copy from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — server-only. Never exposed to the browser.
# Used only by /auth/callback to bootstrap profiles if the trigger missed.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Comma-separated list of emails allowed to sign in.
# Anyone not in this list is signed out by middleware on first request.
ALLOWED_EMAILS=dmytro.o@licentium.io,illia@prokopievlaw.com,eliwonderer@gmail.com

# Comma-separated list of emails with admin powers (edit/delete others' entries).
# Must be a subset of ALLOWED_EMAILS.
ADMIN_EMAILS=dmytro.o@licentium.io,illia@prokopievlaw.com

# Public site URL — used in magic-link redirects.
# Local dev: http://localhost:3000
# Production: https://clockify.licentium.io  (or whatever Illia wires up)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
